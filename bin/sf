#!/usr/bin/env bash
# sf — SpecForge CLI (v2). A thin dispatcher over the deterministic essentials.
# Everything requiring judgment lives in agents/skills, not here.

set -euo pipefail

GREEN='\033[0;32m'
RESET='\033[0m'

find_specforge() {
  local dir="${1:-$(pwd)}"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.specforge/scripts/sf-init.sh" ]; then
      echo "$dir/.specforge"; return 0
    fi
    dir="$(cd "$dir/.." && pwd)"
  done
  return 1
}

require_sf() {
  SF="$(find_specforge "$(pwd)")" || { echo "error: .specforge/ not found. Run: sf init" >&2; exit 1; }
  ROOT="$(dirname "$SF")"
}

SPECFORGE_GIT_URL="${SPECFORGE_GIT_URL:-https://github.com/fibunix/specforge.git}"
SPECFORGE_VERSION="${SPECFORGE_VERSION:-main}"
TMP_CLONE=""
cleanup_clone() { [ -n "$TMP_CLONE" ] && rm -rf "$TMP_CLONE" 2>/dev/null || true; }

_is_source_repo() {
  [ -n "$1" ] && [ -f "$1/.specforge/scripts/sf-update.sh" ] && \
    [ -f "$1/.specforge/canon/root/SPECFORGE.md" ]
}

# Resolve a framework source for upgrades: explicit env, a local dev clone, or
# a fresh shallow clone from GitHub. Echoes the source path.
resolve_source() {
  if [ -n "${SPECFORGE_REPO:-}" ] && _is_source_repo "$SPECFORGE_REPO"; then
    echo "$SPECFORGE_REPO"; return 0
  fi
  local self_dir repo_dir
  self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  repo_dir="$(dirname "$self_dir")"
  if _is_source_repo "$repo_dir" && [ "$repo_dir" != "$ROOT" ]; then
    echo "$repo_dir"; return 0
  fi
  command -v git >/dev/null 2>&1 || { echo "error: git required to fetch SpecForge" >&2; return 1; }
  echo "Fetching SpecForge ($SPECFORGE_VERSION)..." >&2
  TMP_CLONE="$(mktemp -d)/specforge"
  git clone --depth 1 --branch "$SPECFORGE_VERSION" "$SPECFORGE_GIT_URL" "$TMP_CLONE" >/dev/null 2>&1 \
    || { echo "error: could not clone $SPECFORGE_GIT_URL@$SPECFORGE_VERSION" >&2; return 1; }
  echo "$TMP_CLONE"
}

show_help() {
  cat <<'HELP'
sf — SpecForge CLI (v2)

Deterministic essentials (everything else is agent/skill-driven):
  sf init [--ide all|<list>]        Install + project canon into detected/named IDEs
  sf update [--dry-run] [--ide ..]  Re-project canon, preserve user content
  sf doctor                         Health check: canon, profiles, projection drift
  sf worktree create <slug>         Create isolated worktree on feature/<slug>
  sf worktree merge <slug> [--dry-run]   Guardrail-checked ff-merge + archive
  sf merge <slug> [--dry-run]       Alias for 'sf worktree merge'
  sf test [PROJECT-ID]              Run the configured test command(s)
  sf status                         Read-only facts about active work items
  sf help                           Show this help

IDE options: claude-code, opencode, codex, pi, antigravity, all

Workflow lives in the editor as skills/agents:
  /sf "..."     Route a request (direct vs spec lane) and drive it
  /sf-loop      Autonomous coordinator: align→design→test→implement→verify→merge
  /sf-align     /sf-design     /sf-build     /sf-status
HELP
}

[ $# -eq 0 ] && { show_help; exit 0; }
COMMAND="$1"; shift

case "$COMMAND" in
  init)
    SF="$(find_specforge "$(pwd)" 2>/dev/null || true)"
    if [ -n "$SF" ]; then
      echo -e "${GREEN}SpecForge present.${RESET} Reinitializing..."
      bash "$SF/scripts/sf-init.sh" "$@"
    else
      SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
      REPO_DIR="$(dirname "$SELF_DIR")"
      if [ -f "$REPO_DIR/install.sh" ]; then
        bash "$REPO_DIR/install.sh" --source "$REPO_DIR" --dir "$(pwd)" "$@"
      else
        # No local repo (e.g. a stray bin/sf): fetch from GitHub.
        ROOT="$(pwd)"; trap cleanup_clone EXIT
        SRC="$(resolve_source)" || exit 1
        bash "$SRC/install.sh" --source "$SRC" --dir "$(pwd)" "$@"
      fi
    fi
    ;;
  update|upgrade)
    require_sf
    trap cleanup_clone EXIT
    SRC="$(resolve_source)" || exit 1
    # Run the source's updater so framework logic upgrades too.
    bash "$SRC/.specforge/scripts/sf-update.sh" --root "$ROOT" --source "$SRC" "$@"
    ;;
  doctor)   require_sf; bash "$SF/scripts/sf-doctor.sh" ;;
  status)   require_sf; bash "$SF/scripts/sf-status.sh" ;;
  test)     require_sf; bash "$SF/scripts/sf-test.sh" "$@" ;;
  worktree) require_sf; bash "$SF/scripts/sf-worktree.sh" "$@" ;;
  merge)    require_sf; bash "$SF/scripts/sf-worktree.sh" merge "$@" ;;
  help|--help|-h) show_help ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    echo "Run 'sf help' for usage." >&2
    exit 1
    ;;
esac
